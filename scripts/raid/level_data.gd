## 지역 2: 냥냥 항구 창고단지. ~=바다(못 들어감)  Z=컨테이너(가로 2칸)  1=선착장 보트  2=트럭 하역장
const MAPS := {"mart": MAP_MART, "dock": MAP_DOCK, "town": MAP_TOWN}
static var region := "mart"
static var MAP: Array = MAP_MART

static func set_region(id: String) -> void:
	region = id if MAPS.has(id) else "mart"
	MAP = MAPS[region]

const SOLID := "#SsFQCRBTVPKMLGoXDHfZ~"
const FLOOR_UNDER := {"S": "_", "s": "_", "F": "_", "Q": "_", "C": "_", "R": "_", "M": "_", "L": "_", "V": "_",
	"B": "", "T": "", "D": "", "P": "", "K": "", "o": "", "X": ".", "f": "", "G": "=", "H": ",",
	"p": "g", "h": ".", "b": "", "c": "", "1": ".", "2": ",", "Z": ".", "Y": ""}

static func width() -> int:
	return MAP[0].length()

static func height() -> int:
	return MAP.size()

static func code(x: int, y: int) -> String:
	if y < 0 or y >= MAP.size() or x < 0 or x >= MAP[0].length():
		return "#"
	return MAP[y][x]

static func is_solid_code(c: String) -> bool:
	return SOLID.contains(c)

## 물건 아래 깔릴 바닥 재질 (주변 타일에서 추정)
static func floor_code(x: int, y: int) -> String:
	var c := code(x, y)
	if FLOOR_UNDER.has(c):
		var u: String = FLOOR_UNDER[c]
		if u != "":
			return u
		for d in [Vector2i(-1, 0), Vector2i(1, 0), Vector2i(0, -1), Vector2i(0, 1), Vector2i(-1, -1), Vector2i(1, 1)]:
			var n := code(x + d.x, y + d.y)
			if ".,_=gmw-~".contains(n) and n != "~":
				return n if n != "w" and n != "-" else "."
		return ","
	return c
